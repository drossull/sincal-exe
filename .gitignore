# ==========================================
# IGNORAR ARCHIVOS AUTOGENERADOS Y PESADOS
# ==========================================

# 1. Carpetas de compilación de PyInstaller e Inno Setup
build/
dist/
installer_output/
tmp/

# 2. Archivos ejecutables y empaquetados
*.exe
main.spec

# 3. Archivos temporales de caché de Python
__pycache__/
*.pyc
*.pyo
*.pyd
src/**/bin/
src/**/obj/
cad-packages/**/Contents/**/*.dll
cad-packages/**/Contents/**/*.pdb
cad-packages/**/Contents/**/*.deps.json
cad-packages/**/Contents/**/*.runtimeconfig.json

# Fuentes descartadas durante el rediseño monoespaciado de SINCAL 2.0.
assets/fonts/Workbench.ttf
assets/fonts/PassionOne-Bold.ttf
assets/fonts/Lekton-Regular.ttf
assets/fonts/Lekton-Bold.ttf
assets/fonts/OFL-Workbench.txt
assets/fonts/OFL-PassionOne.txt
assets/fonts/OFL-Lekton.txt

# 4. Archivos de sistema operativo (Basura de Windows)
Thumbs.db
desktop.ini
