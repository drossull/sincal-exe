(setq scmt-root (getenv "SINCAL_TEST_ROOT"))
(load (strcat scmt-root "/lisps/MARCAS-SC.lsp"))
(load (strcat scmt-root "/tests/cad/marcas_sc_regression.lsp"))
(command "_.-SCALELISTEDIT" "_Add" "SCMT metres" "1000:25" "_Exit")
(setvar "CANNOSCALE" "SCMT metres")
(setq SCMT:Metric T)
(load (strcat scmt-root "/tests/cad/marcas_sc_upgrade.lsp"))
(if SCMT:Report (progn (write-line "READY_UNDO" SCMT:Report) (close SCMT:Report) (setq SCMT:Report nil)))
