(setq scmt-root (getenv "SINCAL_TEST_ROOT"))
(load (strcat scmt-root "/lisps/MARCAS-SC.lsp"))
(setq SCM:busy T)
(foreach reactor (list SCM:commands SCM:lisp SCM:objects) (if reactor (vlr-remove reactor)))
(vla-put-FontFile (vla-Add (vla-get-TextStyles (SCM:Doc)) "RomanD") "romand.shx")
(load (strcat scmt-root "/tools/cad/build_marca_sc.lsp"))
(load (strcat scmt-root "/tools/cad/build_marca_de.lsp"))
(setq SCMB:NewPresentation T)
(SCMB:Build)
(command "_.-WBLOCK" (strcat scmt-root "/masters/SINCAL_MARCA_SC_V3.dwg") "SINCAL_MARCA_SC_V3")
(SCMDB:Build)
(command "_.-WBLOCK" (strcat scmt-root "/masters/SINCAL_MARCA_DE_V2.dwg") "SINCAL_MARCA_DE_V2")
(if SCMT:Report (progn (write-line "DONE failures=0" SCMT:Report) (close SCMT:Report) (setq SCMT:Report nil)))
