<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CadPlatform Condition="'$(CadPlatform)' == ''">AutoCAD</CadPlatform>
    <CadTargetFramework Condition="'$(CadTargetFramework)' == '' and '$(CadPlatform)' == 'AutoCAD'">net8.0-windows</CadTargetFramework>
    <CadTargetFramework Condition="'$(CadTargetFramework)' == '' and '$(CadPlatform)' == 'ZWCAD'">net48</CadTargetFramework>
    <TargetFramework>$(CadTargetFramework)</TargetFramework>
    <AssemblyName>Sincal.RevisionGrip.$(CadPlatform)</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF Condition="'$(CadPlatform)' == 'AutoCAD'">true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants Condition="'$(CadPlatform)' == 'ZWCAD'">$(DefineConstants);ZWCAD</DefineConstants>
    <DefineConstants Condition="'$(RevisionGripTests)' == 'true'">$(DefineConstants);REVISION_GRIP_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Sincal.DwgProps/RevisionEditor.cs" Link="RevisionEditor.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(CadPlatform)' == 'AutoCAD'">
    <Reference Include="AcMgd"><HintPath>$(CadDir)/acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(CadDir)/acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(CadDir)/accoremgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(CadPlatform)' == 'ZWCAD'">
    <Reference Include="ZwManaged"><HintPath>$(CadDir)/ZwManaged.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ZwDatabaseMgd"><HintPath>$(CadDir)/ZwDatabaseMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevisionGripTests)' == 'true'">
    <Compile Include="../../tests/cad/RevisionGripSmoke.cs" Link="RevisionGripSmoke.cs" />
    <Compile Include="../../tests/cad/RevisionGripDialogSmoke.cs" Link="RevisionGripDialogSmoke.cs" />
    <Compile Include="../../tests/cad/CustomPropertyGripSmoke.cs" Link="CustomPropertyGripSmoke.cs" />
  </ItemGroup>
</Project>
