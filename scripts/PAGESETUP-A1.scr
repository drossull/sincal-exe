(vl-load-com)
(setvar "FILEDIA" 0)

;; 1. Obtener documento en modo consola de fondo
(setq acadApp (vl-catch-all-apply 'vlax-get-acad-object))
(setq doc (if (not (vl-catch-all-error-p acadApp))
              (vla-get-ActiveDocument acadApp)
              (vla-get-Document (vlax-ename->vla-object (namedobjdict)))))

;; 2. Definir rutas maestras
(setq appPath (vl-string-translate "\\" "/" (getenv "APPDATA")))
(setq masterPath (strcat appPath "/Estandar SINCAL/masters/FORMATOS ANOTATIVOS ACAD_2025.dwg"))

;; 3. Borrar silenciosamente el Page Setup viejo si es que existe (Evita el cuelgue por la pregunta "Redefinir?")
(setq psets (vla-get-PlotConfigurations doc))
(setq oldSetup (vl-catch-all-apply 'vla-Item (list psets "SINCAL-A1")))
(if (not (vl-catch-all-error-p oldSetup))
  (vl-catch-all-apply 'vla-Delete (list oldSetup))
)

;; 4. Importar el Page Setup limpio
(vl-cmdf "_.-PSETUPIN" masterPath "SINCAL-A1")

;; 5. Capturar el nuevo Page Setup
(setq psetup (vl-catch-all-apply 'vla-Item (list psets "SINCAL-A1")))

;; 6. Deteccion de ZWCAD
(setq rrp (vl-catch-all-apply 'getvar '("ROAMABLEROOTPREFIX")))
(setq isZW (if (vl-catch-all-error-p rrp) nil (vl-string-search "ZWCAD" (strcase rrp))))

;; 7. Aplicar a cada una de las pestañas (Layouts)
(if (not (vl-catch-all-error-p psetup))
  (progn
    (if isZW (vl-catch-all-apply 'vla-put-ConfigName (list psetup "ZWCAD PDF(High Quality Print).pc5")))
    (vlax-for lay (vla-get-Layouts doc)
      (if (/= (strcase (vla-get-Name lay)) "MODEL")
        (progn
          (vl-catch-all-apply 'vla-CopyFrom (list lay psetup))
          (if isZW (vl-catch-all-apply 'vla-put-ConfigName (list lay "ZWCAD PDF(High Quality Print).pc5")))
          (vl-catch-all-apply 'vla-put-StyleSheet (list lay "SINCAL_A1 (2025).ctb"))
        )
      )
    )
  )
)

;; 8. Ajustes finales y Guardado seguro desde LISP
(setvar "DYNMODE" 3)
(setvar "WIPEOUTFRAME" 0)
(vl-cmdf "_.QSAVE")
(princ)
_.QUIT
