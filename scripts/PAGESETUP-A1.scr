(vl-load-com)
(setq appPath (vl-string-translate "\\" "/" (getenv "APPDATA")))
(setq masterPath (strcat appPath "/Estandar SINCAL/masters/FORMATOS ANOTATIVOS ACAD_2025.dwg"))
(command "_-PSETUPIN" masterPath "SINCAL-A1")
(if (= (logand (getvar "CMDACTIVE") 1) 1) (command "_Y"))

;; TRUCO MAESTRO: Obtener el documento aunque la interfaz grafica este apagada
(setq acadObj (vlax-get-acad-object))
(setq doc (if acadObj (vla-get-ActiveDocument acadObj) (vla-get-Document (vlax-ename->vla-object (namedobjdict)))))

(setq psets (vla-get-PlotConfigurations doc))
(setq psetup (vl-catch-all-apply 'vla-Item (list psets "SINCAL-A1")))

;; Validacion segura para detectar ZWCAD
(setq rrp (vl-catch-all-apply 'getvar '("ROAMABLEROOTPREFIX")))
(setq isZW (if (vl-catch-all-error-p rrp) nil (vl-string-search "ZWCAD" (strcase rrp))))

;; Aplicar configuracion a todos los layouts
(if (not (vl-catch-all-error-p psetup))
  (progn
    (if isZW (vl-catch-all-apply 'vla-put-ConfigName (list psetup "ZWCAD PDF(High Quality Print).pc5")))
    (vlax-for lay (vla-get-Layouts doc)
      (if (/= (strcase (vla-get-Name lay)) "MODEL")
        (progn
          (vla-CopyFrom lay psetup)
          (if isZW (vl-catch-all-apply 'vla-put-ConfigName (list lay "ZWCAD PDF(High Quality Print).pc5")))
          (vl-catch-all-apply 'vla-put-StyleSheet (list lay "SINCAL_A1 (2025).ctb"))
        )
      )
    )
  )
)

(setvar "DYNMODE" 3)
(setvar "WIPEOUTFRAME" 0)
_.QSAVE
_.QUIT
