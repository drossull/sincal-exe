(setvar "FILEDIA" 0)
(setvar "EXPERT" 5)

;; 1. Detectar Impresora y Papel segun el CAD
(setq rrp (vl-catch-all-apply 'getvar '("ROAMABLEROOTPREFIX")))
(setq isZW (if (vl-catch-all-error-p rrp) nil (vl-string-search "ZWCAD" (strcase rrp))))

(setq pdfPrinter (if isZW "ZWCAD PDF(High Quality Print).pc5" "DWG To PDF.pc3"))
(setq paperSize (if isZW "ISO A1 (841 x 594 mm)" "ISO A1 (841.00 x 594.00 MM)"))
(setq ctbName "SINCAL_A1 (2025).ctb")

;; 2. Obtener la lista de Layouts
(setq layouts nil)
(setq dict (dictsearch (namedobjdict) "ACAD_LAYOUT"))
(foreach item dict
  (if (= (car item) 3)
    (if (/= (strcase (cdr item)) "MODEL")
      (setq layouts (cons (cdr item) layouts))
    )
  )
)

;; 3. Forzar configuracion pestaña por pestaña
(foreach lay layouts
  (vl-cmdf "_.-PLOT" 
           "_Y"         ;; Configuracion detallada? [Si]
           lay          ;; Nombre de la pestaña
           pdfPrinter   ;; Dispositivo de impresion
           paperSize    ;; Tamaño de papel
           "_M"         ;; Unidades en Milimetros
           "_L"         ;; Orientacion Landscape (Horizontal)
           "_N"         ;; Trazar al reves? [No]
           "_L"         ;; Area de trazado? [Layout/Presentacion]
           "1:1"        ;; Escala de impresion
           "_C"         ;; Centrar trazado (Desfase x,y)? [Center]
           "_Y"         ;; Trazar con estilos de plumilla? [Si]
           ctbName      ;; Nombre del CTB
           "_Y"         ;; Trazar grosores de linea? [Si]
           "_N"         ;; Escalar grosores con el trazado? [No]
           "_N"         ;; Imprimir espacio papel primero? [No]
           "_N"         ;; Ocultar objetos de espacio papel? [No]
           "_Y"         ;; GUARDAR CAMBIOS AL PAGE SETUP? [SI]
           "_N"         ;; Proceder con la impresion ahora? [No]
  )
)

;; 4. Limpieza y Guardado
(setvar "DYNMODE" 3)
(setvar "WIPEOUTFRAME" 0)
(setvar "EXPERT" 0)
(vl-cmdf "_.QSAVE")
(princ)
_.QUIT
