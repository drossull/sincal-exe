(vl-load-com)
(setq appPath (vl-string-translate "\\" "/" (getenv "APPDATA")))
(setq masterPath (strcat appPath "/Estandar SINCAL/masters/FORMATOS ANOTATIVOS ACAD_2025.dwg"))
(command "_-PSETUPIN" masterPath "SINCAL-A1")
(if (= (logand (getvar "CMDACTIVE") 1) 1) (command "_Y"))
(setq acadObj (vlax-get-acad-object))
(setq doc (vla-get-ActiveDocument acadObj))
(setq psets (vla-get-PlotConfigurations doc))
(setq psetup (vl-catch-all-apply 'vla-Item (list psets "SINCAL-A1")))
(setq isZW (vl-string-search "ZWCAD" (strcase (getvar "ROAMABLEROOTPREFIX"))))
(if (not (vl-catch-all-error-p psetup)) (progn (if isZW (vl-catch-all-apply 'vla-put-ConfigName (list psetup "ZWCAD PDF(High Quality Print).pc5"))) (vlax-for lay (vla-get-Layouts doc) (if (/= (strcase (vla-get-Name lay)) "MODEL") (progn (vla-CopyFrom lay psetup) (if isZW (vl-catch-all-apply 'vla-put-ConfigName (list lay "ZWCAD PDF(High Quality Print).pc5"))) (vl-catch-all-apply 'vla-put-StyleSheet (list lay "SINCAL_A1 (2025).ctb")))))))
(setvar "DYNMODE" 3)
(setvar "WIPEOUTFRAME" 0)
_.QSAVE
_.CLOSE
