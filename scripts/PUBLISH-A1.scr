(vl-load-com)
(setvar "FILEDIA" 0)
(setvar "CMDDIA" 0)
(setvar "BACKGROUNDPLOT" 0)
(setq layoutData (dictsearch (namedobjdict) "ACAD_LAYOUT"))
(setq lays nil)
(foreach item layoutData (if (and (= (car item) 3) (/= (strcase (cdr item)) "MODEL")) (setq lays (cons (cdr item) lays))))
(setq lays (acad_strlsort lays))
(setq rrp (getvar "ROAMABLEROOTPREFIX"))
(setq isZWCAD (and rrp (vl-string-search "ZWCAD" (strcase rrp))))
(setq plotterName (if isZWCAD "ZWCAD PDF(High Quality Print).pc5" "AutoCAD PDF (High Quality Print).pc3"))
(defun SINCAL:SetupLayout (lay / data changed section pair)
  ;; Save the setup without COM and without emitting a PDF.
  (command "_.-PLOT" "_Y" lay plotterName "ISO full bleed A1 (841.00 x 594.00 MM)" "_M" "_L" "_N" "_Layout" "1:1" "0,0" "_Y" "SINCAL_A1 (2025).ctb" "_Y" "_N" "_N" "_N" "" "_Y" "_N")
  (setq data (dictsearch (cdr (assoc -1 layoutData)) lay))
  (if (or (/= (cdr (assoc 2 data)) plotterName) (/= (cdr (assoc 4 data)) "ISO_full_bleed_A1_(841.00_x_594.00_MM)"))
    (progn (princ "\n[SINCAL ERROR] No se pudo configurar el layout A1.") (exit)))
  ;; Only PlotSettings; never layout origins or viewports.
  ;; Autodesk DXF: 77 = resolution level, 78 = custom DPI.
  (setq changed nil section nil)
  (foreach pair data
    (if (= (car pair) 100) (setq section (cdr pair)))
    (if (= section "AcDbPlotSettings")
      (cond ((= (car pair) 77) (setq pair '(77 . 5)))
            ((= (car pair) 78) (setq pair '(78 . 300)))))
    (setq changed (cons pair changed)))
  (if (not (entmod (reverse changed))) (progn (princ "\n[SINCAL ERROR] No se pudo guardar la calidad de ploteo.") (exit)))
  (regapp "PLOTTRANSPARENCY")
  (setq data (entget (cdr (assoc -1 data)) '("PLOTTRANSPARENCY")))
  (setq data (vl-remove-if '(lambda (x) (= (car x) -3)) data))
  (if (not (entmod (append data '((-3 ("PLOTTRANSPARENCY" (1071 . 1)))))))
    (progn (princ "\n[SINCAL ERROR] No se pudo activar transparencia.") (exit)))
)
(setq statusFile (open (strcat sincalOutputDir "status.txt") "w"))
(if (not sincalKeepSetup) (foreach lay lays (SINCAL:SetupLayout lay)))
(setq idx 1)
(foreach lay lays
  (setq outPath (strcat sincalOutputDir (itoa idx) ".pdf"))
  ;; Override physical printers even with KeepSetup, without saving that change.
  (command "_.-PLOT" "_N" lay "" plotterName outPath "_N" "_Y")
  (if (findfile outPath)
    (write-line (strcat "PDF|" outPath) statusFile)
    (write-line (strcat "ERROR|" lay "|PDF no generado") statusFile))
  (setq idx (1+ idx)))
(write-line (strcat "OK|" (itoa (length lays))) statusFile)
(close statusFile)
(if (not sincalKeepSetup) (vl-cmdf "_.QSAVE"))
(princ)
_.QUIT
_Y
